FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    FIREDRAKE_HOME=/opt/firedrake \
    OMPI_MCA_btl_vader_single_copy_mechanism=none \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    python3-venv \
    build-essential \
    gfortran \
    libopenmpi-dev \
    openmpi-bin \
    liblapack-dev \
    libblas-dev \
    git \
    curl \
    wget \
    ca-certificates \
    libgeos-dev \
    libproj-dev \
    && rm -rf /var/lib/apt/lists/*

# Install firedrake + thetis via the official installer
WORKDIR /opt
RUN curl -sSLO https://raw.githubusercontent.com/firedrakeproject/firedrake/master/scripts/firedrake-install \
    && python3 firedrake-install \
        --install thetis \
        --venv-name firedrake \
        --disable-ssh \
        --honour-pythonpath \
        --no-package-manager \
    && rm firedrake-install

# Install additional python packages in the firedrake virtualenv
RUN /opt/firedrake/bin/pip install --no-cache-dir \
    meshio \
    rioxarray \
    xarray[io] \
    scipy \
    geopandas \
    gmsh \
    h5py \
    matplotlib

# Symlink firedrake python for convenience
RUN ln -s /opt/firedrake/bin/python /usr/local/bin/firedrake-python

WORKDIR /data
ENTRYPOINT ["/opt/firedrake/bin/python"]
CMD ["--help"]
